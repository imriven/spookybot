<%- include("partials/admin-shell-start", { title: `Spookybot Admin ${page.title}`, adminUser, activePage, navItems, csrfToken, activeTarget, availableTargets, targetTheme }) %>

<section class="hero hero-compact">
  <span class="badge">Dataset</span>
  <h1><%= page.title %></h1>
  <p><%= page.description %></p>
  <div class="meta"><%= counts[page.countKey] %> records loaded</div>
</section>

<%- include("partials/flash", { flash }) %>

<section class="panel">
  <div class="panel-head">
    <div>
      <h2><%= page.title %></h2>
      <div class="panel-subtitle">Create new records at the top, then expand any summary card to edit or delete it.</div>
    </div>
    <span class="pill"><%= counts[page.countKey] %> total</span>
  </div>

  <% if (page.guide) { %>
    <details class="mini-guide">
      <summary>Admin Notes</summary>
      <div class="mini-guide-grid">
        <div>
          <strong><%= page.guide.summary %></strong>
        </div>
        <div>
          <div class="mini-guide-label">Required</div>
          <% page.guide.required.forEach((item) => { %>
            <div class="mini-guide-item"><%= item %></div>
          <% }) %>
        </div>
        <div>
          <div class="mini-guide-label">Checkboxes</div>
          <% page.guide.toggles.forEach((item) => { %>
            <div class="mini-guide-item"><%= item %></div>
          <% }) %>
        </div>
        <div>
          <div class="mini-guide-label">Notes</div>
          <% page.guide.extras.forEach((item) => { %>
            <div class="mini-guide-item"><%= item %></div>
          <% }) %>
        </div>
      </div>
    </details>
  <% } %>

  <div class="dataset-layout">
    <div class="create-card">
      <div class="panel-head compact">
        <div>
          <h2><%= page.createTitle %></h2>
          <div class="field-note"><%= page.createNote %></div>
        </div>
      </div>

      <% if (page.key === "timers") { %>
        <form class="stack" action="/admin/timers" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="_returnTo" value="<%= page.path %>" />
          <div class="row">
            <label>Name<input name="name" required /></label>
            <label>Interval ms<input name="interval_ms" type="number" value="60000" required /></label>
          </div>
          <div class="row">
            <label>Channel<input name="channel" value="<%= content.timers[0]?.channel || '' %>" required /></label>
            <label>Sort order<input name="sort_order" type="number" value="0" /></label>
          </div>
          <label>Message<textarea name="message" required></textarea></label>
          <div class="actions">
            <label class="inline-check"><input type="checkbox" name="enabled" checked /> Enabled</label>
            <label class="inline-check"><input type="checkbox" name="live_only" checked /> Live only</label>
            <button type="submit">Add Timer</button>
          </div>
        </form>
      <% } %>

      <% if (page.key === "streamers") { %>
        <form class="stack" action="/admin/streamers" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="_returnTo" value="<%= page.path %>" />
          <div class="row">
            <label>Twitch name<input name="twitch_name" required /></label>
            <label>Twitch ID<input name="twitch_id" /></label>
          </div>
          <div class="row">
            <label>Discord name<input name="discord_name" /></label>
            <label>Discord ID<input name="discord_id" /></label>
          </div>
          <label>Discord channel ID<input name="discord_channel_id" /></label>
          <div class="actions">
            <label class="inline-check"><input type="checkbox" name="enabled" checked /> Enabled</label>
            <button type="submit">Add Streamer</button>
          </div>
        </form>
      <% } %>

      <% if (page.key === "shoutouts") { %>
        <form class="stack" action="/admin/shoutouts" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="_returnTo" value="<%= page.path %>" />
          <label>Name<input name="name" required /></label>
          <label>Message<textarea name="message" required></textarea></label>
          <div class="actions">
            <label class="inline-check"><input type="checkbox" name="enabled" checked /> Enabled</label>
            <button type="submit">Add Shoutout</button>
          </div>
        </form>
      <% } %>

      <% if (page.key === "facts") { %>
        <form class="stack" action="/admin/facts" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="_returnTo" value="<%= page.path %>" />
          <label>New fact<textarea name="content" required></textarea></label>
          <label>Sort order<input name="sort_order" type="number" value="0" /></label>
          <div class="actions">
            <label class="inline-check"><input type="checkbox" name="enabled" checked /> Enabled</label>
            <button type="submit">Add Fact</button>
          </div>
        </form>
      <% } %>

      <% if (page.key === "tips") { %>
        <form class="stack" action="/admin/tips" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="_returnTo" value="<%= page.path %>" />
          <label>Title<input name="title" required /></label>
          <label>Tip<textarea name="content" required></textarea></label>
          <div class="actions">
            <label class="inline-check"><input type="checkbox" name="enabled" checked /> Enabled</label>
            <label>Sort order<input name="sort_order" type="number" value="0" /></label>
            <button type="submit">Add Tip</button>
          </div>
        </form>
      <% } %>

      <% if (page.key === "exercises") { %>
        <form class="stack" action="/admin/exercises" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="_returnTo" value="<%= page.path %>" />
          <label>New exercise<textarea name="exercise" required></textarea></label>
          <div class="actions">
            <label class="inline-check"><input type="checkbox" name="enabled" checked /> Enabled</label>
            <label>Sort order<input name="sort_order" type="number" value="0" /></label>
            <button type="submit">Add Exercise</button>
          </div>
        </form>
      <% } %>

      <% if (page.key === "commands") { %>
        <form class="stack" action="/admin/commands" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="_returnTo" value="<%= page.path %>" />
          <div class="row">
            <label>Command name<input name="name" placeholder="!discord or help" required /></label>
            <label>
              Handler
              <select name="handler" required>
                <option value="text">text</option>
                <option value="template">template</option>
                <option value="random_fact">random_fact</option>
                <option value="shoutout_lookup">shoutout_lookup</option>
                <option value="counter">counter</option>
                <option value="title_update">title_update</option>
                <option value="help">help</option>
                <option value="list">list</option>
              </select>
            </label>
          </div>
          <label>Response<textarea name="response" placeholder="Used by text, template, and help handlers"></textarea></label>
          <label>Description<textarea name="description" placeholder="Internal summary shown in admin and help output"></textarea></label>
          <label>Usage<input name="usage" placeholder="!command <arg>" /></label>
          <div class="actions">
            <label class="inline-check"><input type="checkbox" name="enabled" checked /> Enabled</label>
            <label class="inline-check"><input type="checkbox" name="listed" checked /> Listed in commands</label>
            <label class="inline-check"><input type="checkbox" name="requires_privilege" /> Requires privilege</label>
            <label>Sort order<input name="sort_order" type="number" value="0" /></label>
            <button type="submit">Add Command</button>
          </div>
        </form>
      <% } %>
    </div>

    <div class="dataset-list-panel" data-filter-root>
      <div class="filter-bar">
        <label class="filter-label">
          <span>Search</span>
          <input
            data-filter-input
            type="search"
            placeholder="<%= page.searchPlaceholder %>"
            aria-label="<%= page.searchPlaceholder %>"
          />
        </label>
        <% if (records.length > 0) { %>
          <div class="filter-meta" data-filter-count><%= records.length %> records</div>
        <% } %>
      </div>

      <% if (records.length === 0) { %>
        <div class="empty-state persistent"><%= page.recordsEmptyMessage %></div>
      <% } else { %>
        <div class="entity-list">
          <% records.forEach((record) => { %>
            <details class="entity" data-filter-card data-search-text="<%= record.searchText %>">
              <summary>
                <% if (page.key === "timers") { %>
                  <div class="entity-summary">
                    <div>
                      <div class="summary-kicker">#<%= record.id %></div>
                      <h3><%= record.name %></h3>
                      <div class="entity-preview"><%= record.message %></div>
                    </div>
                    <div class="entity-meta">
                      <span class="pill"><%= record.intervalMs %> ms</span>
                      <span class="pill"><%= record.channel %></span>
                      <span class="pill <%= record.enabled ? 'live' : 'disabled' %>"><%= record.enabled ? "Enabled" : "Disabled" %></span>
                      <span class="pill"><%= record.liveOnly ? "Live only" : "Always on" %></span>
                    </div>
                  </div>
                <% } %>

                <% if (page.key === "streamers") { %>
                  <div class="entity-summary">
                    <div>
                      <div class="summary-kicker">Twitch</div>
                      <h3><%= record.twitchName %></h3>
                      <div class="entity-preview">Discord: <%= record.discordName || "Unassigned" %> • Channel: <%= record.discordChannelId || "Not set" %></div>
                    </div>
                    <div class="entity-meta">
                      <span class="pill"><%= record.twitchId || "No Twitch ID" %></span>
                      <span class="pill"><%= record.discordId || "No Discord ID" %></span>
                      <span class="pill <%= record.enabled ? 'live' : 'disabled' %>"><%= record.enabled ? "Enabled" : "Disabled" %></span>
                    </div>
                  </div>
                <% } %>

                <% if (page.key === "shoutouts") { %>
                  <div class="entity-summary">
                    <div>
                      <div class="summary-kicker">Command</div>
                      <h3>!<%= record.name %></h3>
                      <div class="entity-preview"><%= record.message %></div>
                    </div>
                    <div class="entity-meta">
                      <span class="pill <%= record.enabled ? 'live' : 'disabled' %>"><%= record.enabled ? "Enabled" : "Disabled" %></span>
                    </div>
                  </div>
                <% } %>

                <% if (page.key === "facts") { %>
                  <div class="entity-summary">
                    <div>
                      <div class="summary-kicker">Fact #<%= record.id %></div>
                      <h3>Fact Entry</h3>
                      <div class="entity-preview"><%= record.content %></div>
                    </div>
                    <div class="entity-meta">
                      <span class="pill">Order <%= record.sortOrder %></span>
                      <span class="pill <%= record.enabled ? 'live' : 'disabled' %>"><%= record.enabled ? "Enabled" : "Disabled" %></span>
                    </div>
                  </div>
                <% } %>

                <% if (page.key === "tips") { %>
                  <div class="entity-summary">
                    <div>
                      <div class="summary-kicker">Tip #<%= record.id %></div>
                      <h3><%= record.title %></h3>
                      <div class="entity-preview"><%= record.content %></div>
                    </div>
                    <div class="entity-meta">
                      <span class="pill">Order <%= record.sortOrder %></span>
                      <span class="pill <%= record.enabled ? 'live' : 'disabled' %>"><%= record.enabled ? "Enabled" : "Disabled" %></span>
                    </div>
                  </div>
                <% } %>

                <% if (page.key === "exercises") { %>
                  <div class="entity-summary">
                    <div>
                      <div class="summary-kicker">Exercise #<%= record.id %></div>
                      <h3>Exercise Entry</h3>
                      <div class="entity-preview"><%= record.exercise %></div>
                    </div>
                    <div class="entity-meta">
                      <span class="pill">Order <%= record.sortOrder %></span>
                      <span class="pill <%= record.enabled ? 'live' : 'disabled' %>"><%= record.enabled ? "Enabled" : "Disabled" %></span>
                    </div>
                  </div>
                <% } %>

                <% if (page.key === "commands") { %>
                  <div class="entity-summary">
                    <div>
                      <div class="summary-kicker">Command</div>
                      <h3><%= record.name %></h3>
                      <div class="entity-preview"><%= record.description || record.response || "No description set." %></div>
                    </div>
                    <div class="entity-meta">
                      <span class="pill"><%= record.handler %></span>
                      <span class="pill <%= record.enabled ? 'live' : 'disabled' %>"><%= record.enabled ? "Enabled" : "Disabled" %></span>
                      <span class="pill"><%= record.listed ? "Listed" : "Hidden" %></span>
                      <span class="pill"><%= record.requiresPrivilege ? "Privileged" : "Public" %></span>
                    </div>
                  </div>
                <% } %>
              </summary>

              <div class="entity-body">
                <% if (page.key === "timers") { %>
                  <form class="stack" action="/admin/timers/<%= record.id %>" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="_returnTo" value="<%= page.path %>" />
                    <div class="row">
                      <label>Name<input name="name" value="<%= record.name %>" required /></label>
                      <label>Interval ms<input name="interval_ms" type="number" value="<%= record.intervalMs %>" required /></label>
                    </div>
                    <div class="row">
                      <label>Channel<input name="channel" value="<%= record.channel %>" required /></label>
                      <label>Sort order<input name="sort_order" type="number" value="<%= record.sortOrder %>" /></label>
                    </div>
                    <label>Message<textarea name="message" required><%= record.message %></textarea></label>
                    <div class="actions">
                      <label class="inline-check"><input type="checkbox" name="enabled" <%= record.enabled ? "checked" : "" %> /> Enabled</label>
                      <label class="inline-check"><input type="checkbox" name="live_only" <%= record.liveOnly ? "checked" : "" %> /> Live only</label>
                      <button type="submit">Save Timer</button>
                    </div>
                  </form>
                  <form action="/admin/timers/<%= record.id %>/delete" method="post" class="form-spacer">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="_returnTo" value="<%= page.path %>" />
                    <button class="danger" type="submit">Delete Timer</button>
                  </form>
                <% } %>

                <% if (page.key === "streamers") { %>
                  <form class="stack" action="/admin/streamers/<%= record.id %>" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="_returnTo" value="<%= page.path %>" />
                    <div class="row">
                      <label>Twitch name<input name="twitch_name" value="<%= record.twitchName %>" required /></label>
                      <label>Twitch ID<input name="twitch_id" value="<%= record.twitchId || '' %>" /></label>
                    </div>
                    <div class="row">
                      <label>Discord name<input name="discord_name" value="<%= record.discordName || '' %>" /></label>
                      <label>Discord ID<input name="discord_id" value="<%= record.discordId || '' %>" /></label>
                    </div>
                    <label>Discord channel ID<input name="discord_channel_id" value="<%= record.discordChannelId || '' %>" /></label>
                    <div class="actions">
                      <label class="inline-check"><input type="checkbox" name="enabled" <%= record.enabled ? "checked" : "" %> /> Enabled</label>
                      <button type="submit">Save Streamer</button>
                    </div>
                  </form>
                  <form action="/admin/streamers/<%= record.id %>/delete" method="post" class="form-spacer">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="_returnTo" value="<%= page.path %>" />
                    <button class="danger" type="submit">Delete Streamer</button>
                  </form>
                <% } %>

                <% if (page.key === "shoutouts") { %>
                  <form class="stack" action="/admin/shoutouts/<%= record.id %>" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="_returnTo" value="<%= page.path %>" />
                    <label>Name<input name="name" value="<%= record.name %>" required /></label>
                    <label>Message<textarea name="message" required><%= record.message %></textarea></label>
                    <div class="actions">
                      <label class="inline-check"><input type="checkbox" name="enabled" <%= record.enabled ? "checked" : "" %> /> Enabled</label>
                      <button type="submit">Save Shoutout</button>
                    </div>
                  </form>
                  <form action="/admin/shoutouts/<%= record.id %>/delete" method="post" class="form-spacer">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="_returnTo" value="<%= page.path %>" />
                    <button class="danger" type="submit">Delete Shoutout</button>
                  </form>
                <% } %>

                <% if (page.key === "facts") { %>
                  <form class="stack" action="/admin/facts/<%= record.id %>" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="_returnTo" value="<%= page.path %>" />
                    <label>Fact<textarea name="content" required><%= record.content %></textarea></label>
                    <div class="actions">
                      <label class="inline-check"><input type="checkbox" name="enabled" <%= record.enabled ? "checked" : "" %> /> Enabled</label>
                      <label>Sort order<input name="sort_order" type="number" value="<%= record.sortOrder %>" /></label>
                      <button type="submit">Save Fact</button>
                    </div>
                  </form>
                  <form action="/admin/facts/<%= record.id %>/delete" method="post" class="form-spacer">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="_returnTo" value="<%= page.path %>" />
                    <button class="danger" type="submit">Delete Fact</button>
                  </form>
                <% } %>

                <% if (page.key === "tips") { %>
                  <form class="stack" action="/admin/tips/<%= record.id %>" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="_returnTo" value="<%= page.path %>" />
                    <label>Title<input name="title" value="<%= record.title %>" required /></label>
                    <label>Tip<textarea name="content" required><%= record.content %></textarea></label>
                    <div class="actions">
                      <label class="inline-check"><input type="checkbox" name="enabled" <%= record.enabled ? "checked" : "" %> /> Enabled</label>
                      <label>Sort order<input name="sort_order" type="number" value="<%= record.sortOrder %>" /></label>
                      <button type="submit">Save Tip</button>
                    </div>
                  </form>
                  <form action="/admin/tips/<%= record.id %>/delete" method="post" class="form-spacer">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="_returnTo" value="<%= page.path %>" />
                    <button class="danger" type="submit">Delete Tip</button>
                  </form>
                <% } %>

                <% if (page.key === "exercises") { %>
                  <form class="stack" action="/admin/exercises/<%= record.id %>" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="_returnTo" value="<%= page.path %>" />
                    <label>Exercise<textarea name="exercise" required><%= record.exercise %></textarea></label>
                    <div class="actions">
                      <label class="inline-check"><input type="checkbox" name="enabled" <%= record.enabled ? "checked" : "" %> /> Enabled</label>
                      <label>Sort order<input name="sort_order" type="number" value="<%= record.sortOrder %>" /></label>
                      <button type="submit">Save Exercise</button>
                    </div>
                  </form>
                  <form action="/admin/exercises/<%= record.id %>/delete" method="post" class="form-spacer">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="_returnTo" value="<%= page.path %>" />
                    <button class="danger" type="submit">Delete Exercise</button>
                  </form>
                <% } %>

                <% if (page.key === "commands") { %>
                  <form class="stack" action="/admin/commands/<%= record.id %>" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="_returnTo" value="<%= page.path %>" />
                    <div class="row">
                      <label>Command name<input name="name" value="<%= record.name %>" required /></label>
                      <label>
                        Handler
                        <select name="handler" required>
                          <option value="text" <%= record.handler === "text" ? "selected" : "" %>>text</option>
                          <option value="template" <%= record.handler === "template" ? "selected" : "" %>>template</option>
                          <option value="random_fact" <%= record.handler === "random_fact" ? "selected" : "" %>>random_fact</option>
                          <option value="shoutout_lookup" <%= record.handler === "shoutout_lookup" ? "selected" : "" %>>shoutout_lookup</option>
                          <option value="counter" <%= record.handler === "counter" ? "selected" : "" %>>counter</option>
                          <option value="title_update" <%= record.handler === "title_update" ? "selected" : "" %>>title_update</option>
                          <option value="help" <%= record.handler === "help" ? "selected" : "" %>>help</option>
                          <option value="list" <%= record.handler === "list" ? "selected" : "" %>>list</option>
                        </select>
                      </label>
                    </div>
                    <label>Response<textarea name="response"><%= record.response || "" %></textarea></label>
                    <label>Description<textarea name="description"><%= record.description || "" %></textarea></label>
                    <div class="row">
                      <label>Usage<input name="usage" value="<%= record.usage || '' %>" /></label>
                      <label>Sort order<input name="sort_order" type="number" value="<%= record.sortOrder %>" /></label>
                    </div>
                    <div class="actions">
                      <label class="inline-check"><input type="checkbox" name="enabled" <%= record.enabled ? "checked" : "" %> /> Enabled</label>
                      <label class="inline-check"><input type="checkbox" name="listed" <%= record.listed ? "checked" : "" %> /> Listed in commands</label>
                      <label class="inline-check"><input type="checkbox" name="requires_privilege" <%= record.requiresPrivilege ? "checked" : "" %> /> Requires privilege</label>
                      <button type="submit">Save Command</button>
                    </div>
                  </form>
                  <form action="/admin/commands/<%= record.id %>/delete" method="post" class="form-spacer">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="_returnTo" value="<%= page.path %>" />
                    <button class="danger" type="submit">Delete Command</button>
                  </form>
                <% } %>
              </div>
            </details>
          <% }) %>
        </div>

        <div class="empty-state" data-filter-empty hidden><%= page.emptyMessage %></div>
      <% } %>
    </div>
  </div>
</section>

<% if (records.length > 0) { %>
  <%- include("partials/admin-filter-script") %>
<% } %>

<%- include("partials/admin-shell-end") %>
