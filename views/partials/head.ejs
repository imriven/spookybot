<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <style>
      :root {
        --bg: #09050f;
        --bg-top: #140a23;
        --bg-bottom: #040207;
        --panel: rgba(18, 12, 29, 0.88);
        --panel-strong: rgba(28, 18, 44, 0.96);
        --panel-soft: rgba(35, 22, 55, 0.68);
        --line: rgba(166, 116, 255, 0.2);
        --line-strong: rgba(201, 166, 255, 0.36);
        --text: #f4ebff;
        --muted: #b6a7cf;
        --accent: #9f5fff;
        --accent-bright: #ca9eff;
        --accent-soft: rgba(159, 95, 255, 0.18);
        --success: #46d6a2;
        --warning: #e5b45d;
        --danger: #ff6d8c;
        --shadow: 0 28px 80px rgba(0, 0, 0, 0.45);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at top left, rgba(163, 82, 255, 0.18), transparent 24%),
          radial-gradient(circle at top right, rgba(255, 68, 136, 0.12), transparent 20%),
          radial-gradient(circle at bottom center, rgba(107, 42, 201, 0.18), transparent 30%),
          linear-gradient(180deg, var(--bg-top) 0%, var(--bg) 38%, var(--bg-bottom) 100%);
        color: var(--text);
        font-family: "Palatino Linotype", "Book Antiqua", Georgia, serif;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
        background-size: 24px 24px;
        mask-image: radial-gradient(circle at center, black, transparent 82%);
      }

      a {
        color: var(--accent-bright);
        text-decoration: none;
      }

      a:hover {
        color: #f3d8ff;
      }

      main {
        width: min(1520px, calc(100vw - 32px));
        margin: 0 auto;
        padding: 28px 0 72px;
      }

      .hero,
      .panel,
      .count-card,
      .nav-card,
      .sidebar-card,
      .quick-link-card {
        backdrop-filter: blur(18px);
        box-shadow: var(--shadow);
      }

      .hero,
      .panel {
        background: linear-gradient(180deg, rgba(26, 18, 41, 0.96), rgba(12, 8, 22, 0.92));
        border: 1px solid var(--line);
        border-radius: 24px;
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 28px;
        margin-bottom: 22px;
      }

      .hero.hero-compact {
        padding: 24px 26px;
      }

      .hero::after {
        content: "";
        position: absolute;
        inset: auto -20% -45% 45%;
        height: 260px;
        background: radial-gradient(circle, rgba(202, 158, 255, 0.16), transparent 66%);
        pointer-events: none;
      }

      .hero h1 {
        margin: 0 0 10px;
        font-size: clamp(2.2rem, 4vw, 3.5rem);
        letter-spacing: 0.03em;
      }

      .hero p,
      .meta,
      .muted,
      .panel-subtitle,
      .field-note {
        color: var(--muted);
      }

      .grid {
        display: grid;
        gap: 20px;
      }

      .grid-2 {
        grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      }

      .overview-grid {
        display: grid;
        gap: 20px;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        align-items: start;
      }

      .workspace {
        display: grid;
        gap: 22px;
      }

      .admin-shell {
        display: grid;
        gap: 24px;
        grid-template-columns: minmax(240px, 280px) minmax(0, 1fr);
        align-items: start;
      }

      .admin-main {
        min-width: 0;
      }

      .panel {
        padding: 20px;
      }

      .panel h2 {
        margin: 0;
        font-size: 1.3rem;
        letter-spacing: 0.02em;
      }

      .panel-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 14px;
      }

      .panel-head.compact {
        margin-bottom: 10px;
      }

      .status-banner {
        padding: 16px 18px;
        border-radius: 18px;
        border: 1px solid transparent;
        margin-bottom: 16px;
        background: rgba(255, 255, 255, 0.03);
      }

      .status-banner.connected {
        background: rgba(70, 214, 162, 0.09);
        border-color: rgba(70, 214, 162, 0.28);
      }

      .status-banner.not_connected,
      .status-banner.token_missing_or_expired {
        background: rgba(229, 180, 93, 0.1);
        border-color: rgba(229, 180, 93, 0.26);
      }

      .status-banner.refresh_failed {
        background: rgba(255, 109, 140, 0.1);
        border-color: rgba(255, 109, 140, 0.28);
      }

      .flash {
        margin-bottom: 18px;
        padding: 14px 16px;
        border-radius: 16px;
        border: 1px solid transparent;
        background: rgba(255, 255, 255, 0.04);
      }

      .flash.success {
        background: rgba(70, 214, 162, 0.08);
        border-color: rgba(70, 214, 162, 0.26);
      }

      .flash.error {
        background: rgba(255, 109, 140, 0.08);
        border-color: rgba(255, 109, 140, 0.26);
      }

      .kv {
        display: grid;
        grid-template-columns: 150px 1fr;
        gap: 10px 14px;
        font-size: 0.96rem;
      }

      .kv strong {
        color: #ddd0f7;
        font-weight: 600;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: fit-content;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        background: rgba(159, 95, 255, 0.14);
        border: 1px solid rgba(202, 158, 255, 0.22);
        color: #eedbff;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 0.74rem;
        background: rgba(255, 255, 255, 0.06);
        color: var(--muted);
        border: 1px solid rgba(255, 255, 255, 0.06);
      }

      .pill.live {
        color: #dafef2;
        border-color: rgba(70, 214, 162, 0.22);
        background: rgba(70, 214, 162, 0.08);
      }

      .pill.disabled {
        color: #ffd6de;
        border-color: rgba(255, 109, 140, 0.22);
        background: rgba(255, 109, 140, 0.08);
      }

      form {
        margin: 0;
      }

      .stack {
        display: grid;
        gap: 12px;
      }

      .row {
        display: grid;
        gap: 12px;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        align-items: start;
      }

      .section-nav {
        display: grid;
        gap: 12px;
      }

      .nav-card {
        background: linear-gradient(180deg, rgba(26, 18, 41, 0.88), rgba(14, 9, 24, 0.9));
        border: 1px solid var(--line);
        border-radius: 20px;
        padding: 18px;
        position: sticky;
        top: 18px;
      }

      .sidebar-card {
        position: sticky;
        top: 18px;
        display: grid;
        gap: 20px;
        padding: 20px 18px;
        border-radius: 24px;
        border: 1px solid var(--line);
        background: linear-gradient(180deg, rgba(22, 15, 35, 0.96), rgba(11, 8, 20, 0.92));
      }

      .sidebar-brand h1 {
        margin: 14px 0 8px;
        font-size: 1.55rem;
        letter-spacing: 0.04em;
      }

      .sidebar-brand p {
        margin: 0 0 6px;
        color: var(--muted);
      }

      .sidebar-nav,
      .nav-list {
        display: grid;
        gap: 10px;
      }

      .nav-list {
        margin-top: 14px;
      }

      .nav-link {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        background: rgba(255, 255, 255, 0.03);
      }

      .nav-link:hover {
        border-color: var(--line-strong);
        background: var(--accent-soft);
      }

      .nav-link.active {
        border-color: rgba(202, 158, 255, 0.4);
        background: linear-gradient(135deg, rgba(159, 95, 255, 0.2), rgba(77, 30, 140, 0.22));
      }

      .nav-link strong {
        color: var(--text);
      }

      .sidebar-actions {
        display: grid;
      }

      .sidebar-button {
        width: 100%;
      }

      label {
        display: grid;
        gap: 6px;
        font-size: 0.84rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #ccb9ec;
      }

      input,
      select,
      textarea,
      button,
      summary {
        font: inherit;
      }

      input,
      select,
      textarea {
        width: 100%;
        border: 1px solid rgba(201, 166, 255, 0.14);
        border-radius: 14px;
        padding: 12px 14px;
        background: rgba(9, 6, 16, 0.9);
        color: var(--text);
        outline: none;
      }

      input:focus,
      select:focus,
      textarea:focus {
        border-color: rgba(202, 158, 255, 0.4);
        box-shadow: 0 0 0 3px rgba(159, 95, 255, 0.14);
      }

      textarea {
        min-height: 96px;
        resize: vertical;
      }

      .inline-check {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--muted);
        font-size: 0.88rem;
        text-transform: none;
        letter-spacing: 0;
      }

      .inline-check input {
        width: 18px;
        height: 18px;
        margin: 0;
      }

      button {
        border: 0;
        border-radius: 999px;
        padding: 11px 18px;
        background: linear-gradient(135deg, var(--accent), #6f35d8);
        color: #fff8ff;
        cursor: pointer;
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      button:hover {
        filter: brightness(1.06);
      }

      button.secondary {
        background: linear-gradient(135deg, #39275d, #26193b);
      }

      button.ghost {
        background: transparent;
        border: 1px solid var(--line-strong);
        color: var(--text);
      }

      button.danger {
        background: linear-gradient(135deg, #9f224d, #61142e);
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
      }

      .split-panel {
        display: grid;
        gap: 18px;
        grid-template-columns: minmax(280px, 0.82fr) minmax(0, 1.18fr);
      }

      .dataset-layout {
        display: grid;
        gap: 18px;
        grid-template-columns: minmax(300px, 0.8fr) minmax(0, 1.2fr);
        align-items: start;
      }

      .create-card {
        padding: 18px;
        border-radius: 18px;
        background: linear-gradient(180deg, rgba(50, 28, 82, 0.52), rgba(20, 13, 34, 0.4));
        border: 1px solid rgba(202, 158, 255, 0.18);
      }

      .dataset-list-panel {
        display: grid;
        gap: 14px;
        min-width: 0;
      }

      .mini-guide {
        margin-bottom: 18px;
        border: 1px solid rgba(202, 158, 255, 0.14);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.03);
        overflow: hidden;
      }

      .mini-guide summary {
        cursor: pointer;
        padding: 14px 16px;
        color: #ddd0f7;
        font-weight: 600;
      }

      .mini-guide[open] summary {
        border-bottom: 1px solid rgba(202, 158, 255, 0.12);
      }

      .mini-guide-grid {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        padding: 16px;
      }

      .mini-guide-label {
        margin-bottom: 8px;
        color: var(--accent-bright);
        font-size: 0.74rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .mini-guide-item {
        color: var(--muted);
        line-height: 1.5;
      }

      .filter-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 18px;
        border-radius: 18px;
        border: 1px solid rgba(202, 158, 255, 0.14);
        background: linear-gradient(180deg, rgba(33, 20, 52, 0.78), rgba(14, 10, 24, 0.82));
      }

      .filter-label {
        flex: 1 1 280px;
      }

      .filter-label span {
        font-size: 0.76rem;
        letter-spacing: 0.12em;
      }

      .filter-meta {
        color: var(--muted);
        font-size: 0.88rem;
      }

      .entity-list {
        display: grid;
        gap: 14px;
      }

      .entity {
        border: 1px solid rgba(201, 166, 255, 0.12);
        border-radius: 18px;
        background: linear-gradient(180deg, rgba(19, 12, 31, 0.96), rgba(9, 6, 16, 0.92));
        overflow: hidden;
      }

      details.entity summary {
        list-style: none;
        cursor: pointer;
        padding: 16px 18px;
      }

      details.entity summary::-webkit-details-marker {
        display: none;
      }

      details.entity[open] summary {
        border-bottom: 1px solid rgba(201, 166, 255, 0.12);
        background: rgba(255, 255, 255, 0.02);
      }

      .entity-summary {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: flex-start;
      }

      .entity-summary h3 {
        margin: 0 0 6px;
        font-size: 1rem;
      }

      .summary-kicker {
        margin-bottom: 6px;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent-bright);
      }

      .entity-preview {
        color: var(--muted);
        font-size: 0.92rem;
        line-height: 1.45;
      }

      .entity-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
      }

      .entity-body {
        padding: 18px;
      }

      .counts {
        display: grid;
        gap: 12px;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      }

      .link-grid {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      }

      .quick-link-card {
        display: grid;
        gap: 10px;
        padding: 18px;
        border-radius: 20px;
        border: 1px solid rgba(202, 158, 255, 0.16);
        background: linear-gradient(180deg, rgba(36, 23, 58, 0.84), rgba(17, 11, 28, 0.86));
      }

      .quick-link-card:hover {
        border-color: rgba(202, 158, 255, 0.34);
        background: linear-gradient(180deg, rgba(48, 30, 77, 0.9), rgba(20, 12, 32, 0.9));
      }

      .quick-link-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        color: var(--text);
      }

      .count-card {
        padding: 14px;
        border-radius: 18px;
        background: linear-gradient(180deg, rgba(53, 31, 88, 0.72), rgba(27, 17, 44, 0.78));
        border: 1px solid rgba(202, 158, 255, 0.18);
      }

      .count-card span {
        display: block;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--muted);
      }

      .count-card strong {
        display: block;
        margin-top: 6px;
        font-size: 1.7rem;
      }

      .section-anchor {
        scroll-margin-top: 24px;
      }

      code {
        padding: 2px 6px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.06);
      }

      .empty-state {
        padding: 18px;
        border-radius: 18px;
        border: 1px dashed rgba(202, 158, 255, 0.24);
        background: rgba(255, 255, 255, 0.03);
        color: var(--muted);
      }

      .empty-state.persistent {
        min-height: 120px;
        display: grid;
        place-items: center;
      }

      @media (max-width: 1080px) {
        .admin-shell,
        .overview-grid,
        .split-panel,
        .dataset-layout {
          grid-template-columns: 1fr;
        }

        .sidebar-card,
        .nav-card {
          position: static;
        }
      }

      @media (max-width: 640px) {
        .kv {
          grid-template-columns: 1fr;
        }

        .entity-summary {
          flex-direction: column;
        }

        .entity-meta {
          justify-content: flex-start;
        }

        main {
          width: min(100vw - 18px, 1480px);
        }

        .filter-bar {
          padding: 14px;
        }
      }
    </style>
  </head>
  <body>
    <main>
