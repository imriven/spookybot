<%- include("partials/head", { title: "Spookybot Admin Login" }) %>
<section class="hero">
  <span class="badge">Spookybot Admin</span>
  <h1>Enter The Sanctum</h1>
  <p>Authenticate as the exact Twitch bot account configured in <code>TWITCH_BOT_ID</code>. The same OAuth token powers both Twitch API access and chat runtime.</p>
</section>

<%- include("partials/flash", { flash }) %>

<div class="overview-grid">
  <section class="panel">
    <div class="panel-head">
      <div>
        <h2>Connection Status</h2>
        <div class="panel-subtitle">This panel shows whether the bot runtime currently has a valid saved Twitch token.</div>
      </div>
    </div>
    <div class="status-banner <%= authStatus.kind %>">
      <strong><%= authStatus.kind.replaceAll("_", " ") %></strong>
      <div class="muted"><%= authStatus.detail %></div>
    </div>
    <div class="kv">
      <strong>Current login</strong>
      <span><%= authStatus.currentLogin || "None" %></span>
      <strong>Display name</strong>
      <span><%= authStatus.displayName || "None" %></span>
      <strong>Expires at</strong>
      <span><%= formatDate(authStatus.expiresAt) %></span>
      <strong>Last refresh</strong>
      <span><%= formatDate(authStatus.lastRefreshAt) %></span>
      <strong>Last error</strong>
      <span><%= authStatus.lastRefreshError || "None" %></span>
    </div>
  </section>

  <aside class="nav-card">
    <span class="badge">Login Flow</span>
    <div class="panel-subtitle" style="margin-top: 12px;">Use the button below to start a proper OAuth flow with the correct callback and CSRF-safe state value.</div>
    <div class="actions" style="margin-top: 18px;">
      <form action="/admin/login" method="get">
        <input type="hidden" name="start" value="1" />
        <button type="submit">Log In With Twitch</button>
      </form>
    </div>
  </aside>
</div>
<%- include("partials/footer") %>
