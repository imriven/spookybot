  </section>

  <section class="panel">
    <h2>Tips</h2>
    <form class="stack" action="/admin/tips" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>Title<input name="title" required /></label>
      <label>Tip<textarea name="content" required></textarea></label>
      <div class="actions">
        <label class="inline-check"><input type="checkbox" name="enabled" checked /> Enabled</label>
        <label>Sort order<input name="sort_order" type="number" value="0" /></label>
        <button type="submit">Add Tip</button>
      </div>
    </form>
    <div class="entity-list">
      <% content.tips.forEach((tip) => { %>
        <div class="entity">
          <form class="stack" action="/admin/tips/<%= tip.id %>" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label>Title<input name="title" value="<%= tip.title %>" required /></label>
            <label>Tip<textarea name="content" required><%= tip.content %></textarea></label>
            <div class="actions">
              <label class="inline-check"><input type="checkbox" name="enabled" <%= tip.enabled ? "checked" : "" %> /> Enabled</label>
              <label>Sort order<input name="sort_order" type="number" value="<%= tip.sortOrder %>" /></label>
              <button type="submit">Save Tip</button>
            </div>
          </form>
          <form action="/admin/tips/<%= tip.id %>/delete" method="post" style="margin-top: 10px;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="danger" type="submit">Delete</button>
          </form>
        </div>
      <% }) %>
    </div>
  </section>
</div>

<section class="panel" style="margin-top: 20px;">
  <h2>Exercises</h2>
  <form class="stack" action="/admin/exercises" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label>New exercise<textarea name="exercise" required></textarea></label>
    <div class="actions">
      <label class="inline-check"><input type="checkbox" name="enabled" checked /> Enabled</label>
      <label>Sort order<input name="sort_order" type="number" value="0" /></label>
      <button type="submit">Add Exercise</button>
    </div>
  </form>
  <div class="entity-list">
    <% content.exercises.forEach((exercise) => { %>
      <div class="entity">
        <form class="stack" action="/admin/exercises/<%= exercise.id %>" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <label>Exercise<textarea name="exercise" required><%= exercise.exercise %></textarea></label>
          <div class="actions">
            <label class="inline-check"><input type="checkbox" name="enabled" <%= exercise.enabled ? "checked" : "" %> /> Enabled</label>
            <label>Sort order<input name="sort_order" type="number" value="<%= exercise.sortOrder %>" /></label>
            <button type="submit">Save Exercise</button>
          </div>
        </form>
        <form action="/admin/exercises/<%= exercise.id %>/delete" method="post" style="margin-top: 10px;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="danger" type="submit">Delete</button>
